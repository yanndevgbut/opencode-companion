# All variables are optional. Companion works with no configuration.
# Port to try first (CLI flag --port takes precedence). Falls back to the next free port.
OCC_PORT=3000
# Companion state directory (settings, backups, activity log). Default: ~/.opencode-companion
# OCC_HOME=
# Override the OpenCode config directory (same variable OpenCode itself honours).
# OPENCODE_CONFIG_DIR=
# Path to the OpenCode binary if it is not on PATH.
# OPENCODE_BIN=
